    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    f1_score,\n",
    "    roc_auc_score,\n",
    "    classification_report,\n",
    "    ConfusionMatrixDisplay\n",
    ")\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Get the best model found during tuning\n",
    "best_rf_model = rf_search.best_estimator_\n",
    "\n",
    "# Predict on the held-out test set\n",
    "tuned_rf_pred = best_rf_model.predict(X_test)\n",
    "tuned_rf_prob = best_rf_model.predict_proba(X_test)[:, 1]\n",
    "\n",
    "# Calculate evaluation metrics\n",
    "print(\"Tuned Random Forest Results\")\n",
    "print(\"-\" * 35)\n",
    "print(f\"Accuracy:  {accuracy_score(y_test, tuned_rf_pred):.4f}\")\n",
    "print(f\"Precision: {precision_score(y_test, tuned_rf_pred):.4f}\")\n",
    "print(f\"Recall:    {recall_score(y_test, tuned_rf_pred):.4f}\")\n",
    "print(f\"F1-score:  {f1_score(y_test, tuned_rf_pred):.4f}\")\n",
    "print(f\"ROC-AUC:   {roc_auc_score(y_test, tuned_rf_prob):.4f}\")\n",
    "\n",
    "print(\"\\nClassification Report:\")\n",
    "print(classification_report(y_test, tuned_rf_pred))\n",
    "\n",
    "# Plot confusion matrix\n",
    "ConfusionMatrixDisplay.from_predictions(\n",
    "    y_test,\n",
    "    tuned_rf_pred,\n",
    "    display_labels=[\"Stayed\", \"Churned\"],\n",
    "    cmap=\"Blues\"\n",
    ")\n",
    "plt.title(\"Tuned Random Forest - Confusion Matrix\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
